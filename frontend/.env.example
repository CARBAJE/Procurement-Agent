# ─── NextAuth core ──────────────────────────────────────────────────────────
# The public URL of THIS Next.js app. In dev keep as localhost; in production
# set to your real hostname (the Keycloak client must list the corresponding
# /api/auth/callback/keycloak URL as a Valid Redirect URI).
NEXTAUTH_URL=http://localhost:3000

# Random secret used to sign next-auth's session JWT. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# ─── Phase Two (phasetwo.io) — OIDC identity provider ───────────────────────
# Realm issuer URL. For cloud free tier the pattern is:
#   https://app.phasetwo.io/auth/realms/<your-realm-name>
# For self-hosted: https://<your-keycloak-host>/realms/<realm>
KEYCLOAK_ISSUER=https://euc1.auth.ac/auth

# Client ID and secret from your "procurement-frontend" client in the
# Phase Two dashboard. The client must be configured with:
#   - Client authentication: ON  (confidential client)
#   - Standard flow: enabled     (authorization code + PKCE)
#   - Valid Redirect URI: ${NEXTAUTH_URL}/api/auth/callback/keycloak
#   - Web origins: ${NEXTAUTH_URL}
KEYCLOAK_CLIENT_ID=procurement-frontend
KEYCLOAK_CLIENT_SECRET=

# ─── Backend (orchestrator) — unchanged ─────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
