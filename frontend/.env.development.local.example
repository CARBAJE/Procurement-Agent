# Frontend dev-only environment file.
#
# Copy this to `.env.development.local` (which is git-ignored) and adjust
# the URLs to match your local backend topology. The Next.js dev server
# reads these on startup; restart `npm run dev` after editing.
#
# ── Original BAP backend (Bap-1/) — unchanged ──────────────────────────
# The legacy /api/procurement/{parse,compare,commit} routes proxy here.
BAP_URL=http://localhost:8000

# ── NEW: Dynamic Mock Gateway (services/frontend_demo_gateway) ─────────
# The /api/demo/{score,negotiate} routes proxy here. The gateway loads
# the real Phase-2 PyTorch model and the real Phase-3 LangGraph state
# machine so the demo UI reflects production behaviour without needing
# MLflow, Postgres, Redis, Kafka, or live Beckn networks.
#
# Boot the gateway with:
#   conda activate infosys_project
#   cd services/frontend_demo_gateway
#   uvicorn frontend_demo_gateway.main:app --port 8005
#
DEMO_GATEWAY_URL=http://localhost:8005
