# Prediction API — FastAPI inference server.
# Loads the `ProcurementRanker` model from the MLflow registry at startup
# and serves ranking requests on :8004.

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Build deps for PyTorch / scientific wheels + curl for healthcheck.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps first to maximise Docker layer caching.
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Application code: shared model/feature extraction in core/, API in prediction_api/.
COPY core/ ./core/
COPY prediction_api/ ./prediction_api/

EXPOSE 8004

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=5 \
    CMD curl -fsS http://localhost:8004/health || exit 1

CMD ["uvicorn", "prediction_api.main:app", "--host", "0.0.0.0", "--port", "8004"]
