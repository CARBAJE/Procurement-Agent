# Training pipeline — batch job.
# Trains RankNet/SGD on historical procurement data, logs metrics & artifacts
# to MLflow, and registers the resulting model under `ProcurementRanker`.

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY core/ ./core/
COPY training_pipeline/ ./training_pipeline/

CMD ["python", "-m", "training_pipeline.train"]
