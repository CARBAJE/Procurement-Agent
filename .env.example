# Root .env template — copy to `.env` and adjust DB_HOST for your machine.
#   cp .env.example .env
#
# This is the SINGLE source of truth for the PostgreSQL connection. Docker
# Compose substitutes these into every service that talks to procurement_agent
# (data-normalizer, analytics, erp-adapter). The defaults baked into
# docker-compose.yml assume a NATIVE host Postgres; override here if needed.
#
# ── DB_HOST: pick the line that matches YOUR setup ──────────────────────────
#
#   PostgreSQL as a Docker container on beckn_network (e.g. procurement-postgres):
#     DB_HOST=procurement-postgres
#
#   PostgreSQL installed natively on the host machine:
#     DB_HOST=host.docker.internal
#
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=procurement_agent
DB_USER=postgres
DB_PASSWORD=postgres123

# ── Claude Code OpenAI Proxy (:8012) ────────────────────────────────────────
# Path to the `claude` CLI binary. Override for your OS:
#   macOS (Homebrew):  /opt/homebrew/bin/claude
#   Linux (npm/nvm):   /home/<user>/.local/bin/claude
CLAUDE_PROXY_BINARY_PATH=/opt/homebrew/bin/claude
# Optional bearer token to protect the proxy endpoint (any non-empty string).
CLAUDE_PROXY_KEY=
